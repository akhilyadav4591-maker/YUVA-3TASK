* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: #1e293b;
    background: #f8fafc;
    line-height: 1.6;
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

button,
input,
textarea {
    font-family: inherit;
}

.container {
    width: 90%;
    max-width: 1150px;
    margin: auto;
}

section {
    padding: 80px 0;
}

h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 25px;
}

.section-label {
    color: #2563eb;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.center {
    text-align: center;
}

.header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #172554;
}

.navbar {
    width: 90%;
    max-width: 1200px;
    min-height: 70px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    color: white;
    font-size: 25px;
    font-weight: bold;
}

.nav-links {
    display: flex;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    color: white;
    font-weight: bold;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #93c5fd;
}

.menu-btn {
    display: none;
    border: none;
    background: transparent;
    color: white;
    font-size: 28px;
    cursor: pointer;
}

.hero {
    min-height: 85vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 80px 20px;
    text-align: center;
    color: white;
    background: linear-gradient(
        135deg,
        #2563eb,
        #7c3aed
    );
}

.hero-content {
    max-width: 850px;
}

.subtitle {
    font-size: 14px;
    letter-spacing: 3px;
    font-weight: bold;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1.1;
    margin-bottom: 25px;
}

.hero-content > p:not(.subtitle):not(.welcome-message) {
    font-size: clamp(1rem, 2vw, 1.3rem);
}

.hero-buttons {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    padding: 13px 25px;
    border: 2px solid white;
    border-radius: 30px;
    background: white;
    color: #2563eb;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.btn:hover {
    transform: translateY(-4px);
}

.outline-btn {
    background: transparent;
    color: white;
}

.welcome-message {
    min-height: 30px;
    margin-top: 20px;
    font-weight: bold;
}

.about {
    background: white;
}

.about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.about-text p {
    margin-bottom: 15px;
}

.about-image {
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
}

.about-image img {
    width: 100%;
}

.features {
    background: #f1f5f9;
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
}

.feature-card {
    padding: 30px 20px;
    background: white;
    border-radius: 18px;
    text-align: center;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    transition: 0.3s;
}

.feature-card:hover {
    transform: translateY(-8px);
}

.feature-icon {
    font-size: 45px;
    margin-bottom: 15px;
}

.feature-card h3 {
    margin-bottom: 10px;
    color: #172554;
}

.counter-section {
    background: #e0e7ff;
    text-align: center;
}

.counter-box {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 25px;
    margin: 30px 0;
}

.counter-box span {
    min-width: 100px;
    font-size: 50px;
    font-weight: bold;
    color: #2563eb;
}

.counter-btn {
    width: 55px;
    height: 55px;
    border: none;
    border-radius: 50%;
    background: #2563eb;
    color: white;
    font-size: 30px;
    cursor: pointer;
    transition: 0.3s;
}

.counter-btn:hover {
    transform: scale(1.1);
}

.reset-btn {
    padding: 10px 25px;
    border: none;
    border-radius: 20px;
    background: #172554;
    color: white;
    cursor: pointer;
}

.faq {
    background: white;
}

.faq-container {
    max-width: 800px;
    margin: auto;
}

.faq-item {
    margin-bottom: 15px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    overflow: hidden;
}

.faq-question {
    width: 100%;
    padding: 18px 20px;
    border: none;
    background: #f8fafc;
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

.faq-answer {
    display: none;
    padding: 20px;
    background: white;
}

.faq-item.active .faq-answer {
    display: block;
}

.faq-item.active .faq-question span {
    transform: rotate(45deg);
}

.contact {
    background: #f8fafc;
}

.contact-description {
    max-width: 650px;
    margin: 0 auto 35px;
    text-align: center;
}

.contact-form {
    width: 90%;
    max-width: 650px;
    margin: auto;
    padding: 35px;
    background: white;
    border-radius: 20px;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 7px;
    font-weight: bold;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 13px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    outline: none;
    font-size: 16px;
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: #2563eb;
}

.form-group textarea {
    resize: vertical;
}

.form-group small {
    display: block;
    margin-top: 5px;
    min-height: 18px;
}

.submit-btn {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 25px;
    background: #2563eb;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.submit-btn:hover {
    transform: translateY(-2px);
}

.success-message {
    margin-top: 15px;
    text-align: center;
    font-weight: bold;
}

.footer {
    padding: 25px 20px;
    text-align: center;
    background: #172554;
    color: white;
}

@media (max-width: 900px) {
    .about-content {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .about-image {
        max-width: 600px;
        margin: auto;
    }

    .feature-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {
    section {
        padding: 60px 0;
    }

    .menu-btn {
        display: block;
    }

    .nav-links {
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        padding: 20px;
        display: none;
        flex-direction: column;
        gap: 20px;
        background: #172554;
        text-align: center;
    }

    .nav-links.active {
        display: flex;
    }

    .hero {
        min-height: 75vh;
        padding: 60px 20px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: center;
    }

    .btn {
        width: 220px;
    }

    .feature-grid {
        grid-template-columns: 1fr;
    }

    .counter-box {
        gap: 15px;
    }

    .counter-box span {
        font-size: 40px;
    }

    .contact-form {
        width: 95%;
        padding: 25px 20px;
    }
}

@media (max-width: 400px) {
    .logo {
        font-size: 21px;
    }

    .hero h1 {
        font-size: 35px;
    }

    .hero-content > p {
        font-size: 15px;
    }

    h2 {
        font-size: 28px;
    }
}
